{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "",
        "sources": "https://github.com/Sir-Cow/noWorldborderTint"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "client",
    "entrypoints": {
        "main": [
            "sircow.noworldbordertint.NoWorldborderTint"
        ],
        "modmenu": [
            "sircow.noworldbordertint.config.ModMenuCompat"
        ]
    },
    "mixins": [
        "noworldbordertint.mixins.json",
        "noworldbordertint.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.18.5",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}",
        "fabric-language-kotlin": ">=1.13.9"
    },
    "suggests": {
        "another-mod": "*"
    },
    "custom": {
        "modmenu": {
            "update_checker": true
        }
    }
}
  